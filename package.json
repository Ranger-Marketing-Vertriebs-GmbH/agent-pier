{
  "name": "agentpier",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:stop": "node scripts/service.mjs stop",
    "tailscale": "node scripts/tailscale.mjs",
    "remote": "node scripts/remote.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:blackbox": "node scripts/test.mjs blackbox",
    "test:property": "node scripts/test.mjs property",
    "test:matrix": "node scripts/test.mjs matrix",
    "test:affected": "node scripts/affected-tests.mjs --run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-structure.mjs",
    "i18n:confirm": "node scripts/i18n-confirm.mjs",
    "check": "npm run lint && npm run format:check && npm run check:structure && npm run build && npm test",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "buffer-crc32": "1.0.0",
    "compression": "^1.8.2",
    "css-tree": "3.2.1",
    "es-module-lexer": "3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "3.3.2",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "node-pty": "^1.1.0",
    "parse5": "8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "ssh2": "1.17.0",
    "toml-eslint-parser": "^1.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.28.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "description": "Local coding CLI workspace with mobile chat, recoverable delivery and review pipelines",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier.git"
  },
  "homepage": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier#readme",
  "bugs": {
    "url": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier/issues"
  },
  "allowScripts": {
    "cpu-features@0.0.10": false,
    "koffi@3.3.2": false,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": false
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
