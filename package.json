{
  "name": "agentpier",
  "version": "1.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:stop": "node scripts/service.mjs stop",
    "tailscale": "node scripts/tailscale.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:blackbox": "node scripts/test.mjs blackbox",
    "test:property": "node scripts/test.mjs property",
    "test:matrix": "node scripts/test.mjs matrix",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "npm run lint && npm run format:check && npm run check:structure && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "toml-eslint-parser": "^1.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.19.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "description": "Local coding CLI workspace with mobile chat, recoverable delivery and review pipelines",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier.git"
  },
  "homepage": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier#readme",
  "bugs": {
    "url": "https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier/issues"
  }
}
