#!/bin/sh
set -eu
umask 077
INSTALLER_VERSION='@@VERSION@@'
INSTALLER_SHA256='@@SHA256@@'
fail() { echo "$1" >&2; exit 1; }
validate() {
  repair=0 custom=0 skip=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help) [ "$#" = 1 ] || fail 'Help cannot be combined with setup options.'; echo 'AgentPier installer: --no-service --install-root PATH --data-dir PATH --skip-dependencies --dependencies-only'; exit 0;;
      --version) [ "$#" = 1 ] || fail 'Version cannot be combined with setup options.'; echo "$INSTALLER_VERSION"; exit 0;;
      --no-service) custom=1;;
      --skip-dependencies) skip=1;;
      --dependencies-only) repair=1;;
      --install-root|--data-dir)
        custom=1; [ "$#" -gt 1 ] || fail 'Missing setup option value.'
        shift; case "$1" in /*) ;; *) fail 'Setup paths must be absolute.';; esac;;
      *) fail 'Invalid setup option.';;
    esac
    shift
  done
  [ "$repair" = 0 ] || { [ "$custom" = 0 ] && [ "$skip" = 0 ]; } || fail 'Conflicting dependency repair options.'
}
validate "$@"
[ "$(uname -s)" = Darwin ] || fail 'Online setup currently supports macOS only.'
case "$(uname -m)" in arm64|x86_64) ;; *) fail 'Unsupported macOS architecture.';; esac
[ "$(sysctl -in sysctl.proc_translated 2>/dev/null || true)" != 1 ] || fail 'Open a native terminal instead of Rosetta and retry.'
macos_version=$(sw_vers -productVersion)
[ "${macos_version%%.*}" -ge 14 ] || fail 'macOS 14 or newer is required.'
[ "$(id -u)" != 0 ] || fail 'Run setup as your normal user, without sudo.'
TEMP_ROOT=$(mktemp -d)
trap 'rm -rf "$TEMP_ROOT"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
BASE="https://github.com/Ranger-Marketing-Vertriebs-GmbH/agent-pier/releases/download/v$INSTALLER_VERSION"
curl --fail --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
  --connect-timeout 30 --max-time 120 --max-filesize 16777216 \
  "$BASE/agentpier-installer-$INSTALLER_VERSION.tar.gz" -o "$TEMP_ROOT/bundle.tar.gz"
[ "$(wc -c < "$TEMP_ROOT/bundle.tar.gz")" -le 16777216 ] || fail 'Installer download exceeds size limit.'
if command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$TEMP_ROOT/bundle.tar.gz" | awk '{print $1}')
else
  actual=$(sha256sum "$TEMP_ROOT/bundle.tar.gz" | awk '{print $1}')
fi
[ "$actual" = "$INSTALLER_SHA256" ] || fail 'Installer checksum mismatch.'
# Bound decompression before tar inspects any member. head is present on macOS.
gzip -dc "$TEMP_ROOT/bundle.tar.gz" | head -c 67108865 > "$TEMP_ROOT/bundle.tar"
[ "$(wc -c < "$TEMP_ROOT/bundle.tar")" -le 67108864 ] || fail 'Expanded installer exceeds size limit.'
LC_ALL=C tar -tf "$TEMP_ROOT/bundle.tar" > "$TEMP_ROOT/members"
awk 'BEGIN { ok=1 } NR>10000 || $0 !~ /^[A-Za-z0-9_@.+\/-]+$/ || $0 ~ /^\// || $0 ~ /(^|\/)\.\.?($|\/)/ { ok=0 } END { exit !ok }' "$TEMP_ROOT/members" || fail 'Unsafe installer archive path or member count.'
LC_ALL=C tar -tvf "$TEMP_ROOT/bundle.tar" > "$TEMP_ROOT/types"
awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" { bad=1 } END { exit bad }' "$TEMP_ROOT/types" || fail 'Installer archive contains links or special files.'
mkdir "$TEMP_ROOT/source"
tar -xf "$TEMP_ROOT/bundle.tar" -C "$TEMP_ROOT/source" --no-same-owner
[ -f "$TEMP_ROOT/source/scripts/setup.sh" ] || fail 'Installer setup entrypoint is missing.'
/bin/sh "$TEMP_ROOT/source/scripts/setup.sh" "$@"
