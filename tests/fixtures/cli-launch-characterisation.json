  "providers": {
    "codex/openrouter": {
      "command": "<root>/fixture-bin/codex",
      "args": [
        "-c",
        "model=\"anthropic/claude-sonnet-4.6\"",
        "-c",
        "model_provider=\"openrouter\"",
        "-c",
        "cli_auth_credentials_store=\"file\"",
        "-c",
        "mcp_oauth_credentials_store=\"file\"",
        "-c",
        "model_providers={\"openrouter\"={\"name\"=\"OpenRouter\",\"wire_api\"=\"responses\",\"base_url\"=\"https://openrouter.ai/api/v1\",\"auth\"={\"command\"=\"sh\",\"args\"=[\"-c\",\"printf '%s' \\\"$OPENROUTER_API_KEY\\\"\"]}}}",
        "-c",
        "model_context_window=1000000",
        "--model",
        "anthropic/claude-sonnet-4.6"
      ],
      "env": {
        "CODEX_HOME": "<root>/data/profiles/<account>/providers/openrouter/codex",
        "HOME": "<root>",
        "OPENROUTER_API_KEY": "fixture-provider-key",
        "PATH_added": [
          "<root>/data/clis/codex/bin",
          "<root>/data/clis/claude/bin",
          "<root>/data/clis/opencode/bin",
          "<root>/data/clis/gh/bin"
        ]
      },
      "codexConfig": "model = \"anthropic/claude-sonnet-4.6\"\nmodel_provider = \"openrouter\"\ncli_auth_credentials_store = \"file\"\nmcp_oauth_credentials_store = \"file\"\nmodel_context_window = 1000000\n\n[model_providers.openrouter]\nname = \"OpenRouter\"\nwire_api = \"responses\"\nbase_url = \"https://openrouter.ai/api/v1\"\n\n[model_providers.openrouter.auth]\ncommand = \"sh\"\nargs = [ \"-c\", \"printf '%s' \\\"$OPENROUTER_API_KEY\\\"\" ]\n"
    },
