    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "main"
      },
      "workspace": "/golden/assistants/workspaces",
      "skills": [],
      "maxConcurrent": 12
    }
  },
  "models": {
    "providers": {
      "p": {
        "baseUrl": "http://127.0.0.1:9"
      },
      "llama-cpp": {
        "baseUrl": "http://127.0.0.1:18111/v1",
        "api": "openai-completions",
        "models": [],
        "params": {
          "modelCacheDir": "/golden/assistants/embeddings/models"
        },
        "localService": {
          "command": "/bin/sh",
          "args": [
            "-c",
            "echo \"$$\" > \"$1\" && shift && exec \"$@\"",
            "agentpier-embedding-server",
            "/golden/assistants/embeddings/llama-server.pid",
            "/golden/assistants/embeddings/llama.cpp/b10809-linux-x64/llama-server",
            "--host",
            "127.0.0.1",
            "--port",
            "18111",
            "--models-preset",
            "/golden/assistants/embeddings/llama-models.ini",
            "--models-max",
            "1",
            "--no-ui"
          ],
          "healthUrl": "http://127.0.0.1:18111/health",
          "readyTimeoutMs": 120000,
          "idleStopMs": 600000
        }
      }
    }
  },
  "talk": {
    "agentId": "main"
  },
  "channels": {},
  "browser": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "telemetry": {
    "enabled": false
  },
  "update": {
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "/golden/assistants/skill-catalog/skills"
      ],
      "watch": true
    },
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "tools": {
    "allow": [
      "session_status",
      "agentpier_team_propose",
      "agentpier_team_status",
      "agentpier_team_stop",
      "agentpier_team_members",
      "agentpier_team_ask",
      "agentpier_team_delegate",
      "agentpier_team_cancel",
      "agentpier_team_groups",
      "agentpier_team_group_delegate",
      "agentpier_team_archive",
      "agentpier_team_grant",
      "agentpier_team_member_update",
      "agentpier_team_member_summarise",
      "agentpier_team_models",
      "agentpier_team_member_routine",
      "agentpier_team_promote",
      "agentpier_team_templates",
      "agentpier_team_peers",
      "agentpier_team_peer_ask",
      "agentpier_team_peer_delegate",
      "agentpier_team_report",
      "memory_search",
      "memory_get",
      "read",
      "write",
      "edit",
      "sessions_list",
      "sessions_history",
      "sessions_search",
      "agentpier_reminder",
      "agentpier_routine",
      "agentpier_workspace",
      "agentpier_ssh",
      "agentpier_share_file",
      "agentpier_pinboard",
      "agentpier_card",
      "agentpier_goal",
      "agentpier_hook",
      "agentpier_ssh_access",
      "agentpier_coding_session",
      "agentpier_mail",
      "agentpier_project",
      "agentpier_preview",
      "agentpier_craft",
      "agentpier_device",
      "ask_user",
      "web_fetch",
      "view_image"
    ],
    "toolSearch": {
      "mode": "directory"
    },
    "codeMode": false,
    "exec": {
      "mode": "deny"
    },
    "sessions": {
      "visibility": "agent"
    },
    "fs": {
      "workspaceOnly": true
    },
    "web": {
      "fetch": {
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": false
        }
      }
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-core"
    },
    "allow": [
      "agentpier-teams",
      "openai",
      "memory-core",
      "llama-cpp"
    ],
    "load": {
      "paths": [
        "/golden/plugin",
        "/golden/runtime/app/node_modules/@openclaw/llama-cpp-provider"
      ]
    },
    "entries": {
      "agentpier-teams": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "url": "http://127.0.0.1:1235",
          "token": "bridge-token",
          "workspaces": "/golden/assistants/workspaces"
        },
        "llm": {
          "allowAgentIdOverride": true
        }
      },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false,
      "provider": "local",
      "sources": [
        "memory"
      ],
      "rememberAcrossConversations": false,
      "fallback": "none",
      "local": {
        "modelPath": "/golden/assistants/embeddings/models/hf_ggml-org_embeddinggemma-300m-qat-Q8_0.gguf"
      }
    }
  },
  "cron": {
    "enabled": true,
    "webhookToken": "hook-token",
    "webhookSsrfPolicy": {
      "allowedHostnames": [
        "127.0.0.1"
      ]
    }
  },
  "session": {
    "maintenance": {
      "archiveDashboardAfter": false
    }
  },
  "logging": {
    "file": "/golden/assistants/logs/openclaw.log",
    "level": "warn",
    "consoleLevel": "warn",
    "maxFileBytes": 10485760
  },
  "diagnostics": {
    "flags": [],
    "otel": {
      "enabled": false,
      "captureContent": false
    },
    "cacheTrace": {
      "enabled": false
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18000,
    "auth": {
      "mode": "token",
      "token": "golden-token"
    },
    "controlUi": {
      "enabled": false
    },
    "terminal": {
      "enabled": false
    },
    "tailscale": {
      "mode": "off"
    },
    "reload": {
      "mode": "hybrid"
    }
  }
}
